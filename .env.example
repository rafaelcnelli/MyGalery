# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# FIREBASE CONFIGURATION (GitHub Pages / Vite Environment Variables)
# Configure VITE_FIREBASE_API_KEY in GitHub Actions Secrets or .env.local so GitHub Secret Scanning never flags your repo.
VITE_FIREBASE_API_KEY="YOUR_FIREBASE_API_KEY"
VITE_FIREBASE_AUTH_DOMAIN="gen-lang-client-0184131312.firebaseapp.com"
VITE_FIREBASE_PROJECT_ID="gen-lang-client-0184131312"
VITE_FIREBASE_STORAGE_BUCKET="gen-lang-client-0184131312.firebasestorage.app"
VITE_FIREBASE_MESSAGING_SENDER_ID="952928530363"
VITE_FIREBASE_APP_ID="1:952928530363:web:254ee5ad64721d2c531e9e"
VITE_FIREBASE_FIRESTORE_DATABASE_ID="ai-studio-bb4f3703-a328-40a5-8152-a53c6826731d"


